config_version=5
[application]
boot_splash/image="res://assets/shroom_loader.png"
boot_splash/bg_color=Color(0.07451,0.0549,0.1098,1)
boot_splash/show_image=true
boot_splash/fullsize=true
config/icon="res://assets/shroom.png"
config/name="Shroom"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="OnKlav/app.onklav.shroom"
config/auto_accept_quit=false
config/quit_on_go_back=false
[autoload]
OnKlavGame="*res://onklav_game.gd"
[display]
window/size/viewport_width=1000
window/size/viewport_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.09,0.10,0.13,1)

[audio]
general/default_playback_type=1
driver/output_latency=100
driver/output_latency.web=160
