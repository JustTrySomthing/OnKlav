{
  "schema": "onklav.app.v1",
  "runtime": "rust-wasm-ui.v1",
  "id": "org.example.referencemail",
  "name": "Reference mail",
  "version": 1,
  "capabilities": [
    "storage.private",
    "network.http",
    "accounts.connect",
    "files.external",
    "files.export",
    "background.tasks"
  ],
  "network": {
    "origins": [
      "https://mail.example.org"
    ],
    "accounts": [
      {
        "id": "mail",
        "label": "Configured mail provider",
        "authorization_endpoint": "https://mail.example.org/authorize",
        "token_endpoint": "https://mail.example.org/token",
        "client_id": "example-public-client",
        "scopes": [
          "mail.read",
          "mail.send"
        ],
        "api_origins": [
          "https://mail.example.org"
        ]
      }
    ]
  },
  "min_host": 78,
  "icon": {
    "symbol": "reader"
  }
}
