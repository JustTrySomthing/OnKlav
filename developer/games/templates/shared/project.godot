config_version=5
[application]
boot_splash/image="res://onklav-splash.png"
boot_splash/bg_color=Color(0.37647,0.23922,0.46667,1)
boot_splash/show_image=true
boot_splash/fullsize=false
config/icon="res://onklav-splash.png"
config/name="TITLE"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="OnKlav/GAME_ID"
config/auto_accept_quit=false
config/quit_on_go_back=false
[autoload]
OnKlavGame="*res://onklav_game.gd"
[display]
window/size/viewport_width=600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.09,0.10,0.13,1)

[audio]
general/default_playback_type=1
driver/output_latency=100
driver/output_latency.web=100
